# Auth.js session secret (encrypts the JWT session cookie). Generate with:
#   openssl rand -base64 33
AUTH_SECRET=replace-with-at-least-32-random-characters

# Recommended in production to force the canonical public URL used by Auth.js.
# Example: https://alina.example.eu
# AUTH_URL=https://your-public-url

# Required when the container runs behind a reverse proxy or load balancer
# (ECS behind an ALB, Railway, ...).
# AUTH_TRUST_HOST=true

# First administrator. Read at server start; the account is created only when
# the database holds no admin yet, so these can stay set or be removed later.
# The password must be at least 12 characters and is replaced at first sign-in.
ADMIN_EMAIL=admin@example.eu
ADMIN_PASSWORD=replace-with-a-temporary-password
# ADMIN_NAME=ALINA administrator

# PostgreSQL local development
DATABASE_URL=postgresql://alina:alina-local@localhost:5432/alina

# ECS can inject the RDS secret as individual values instead of DATABASE_URL.
# DB_HOST=your-rds-endpoint
# DB_PORT=5432
# DB_NAME=alina
# DB_USER=alina_app
# DB_PASSWORD=replace-with-secret
# DB_SSL=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DB_POOL_MAX=5
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=30000

# Railway (see docs/railway-deployment-guide.md)
# Reference the Postgres plugin over the private network and disable TLS,
# because Railway's internal Postgres endpoint does not serve TLS and the
# production default would otherwise verify against the bundled AWS RDS CA.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DB_SSL=false
# AUTH_URL=https://<service>.up.railway.app
# AUTH_TRUST_HOST=true

# LLM wiki: bearer token the retrieval pipeline presents to POST /api/mcp.
# Generate with `openssl rand -hex 32`. Unset = MCP endpoint disabled.
# WIKI_MCP_TOKEN=replace-with-a-long-random-token

# Haystack Enterprise
HAYSTACK_API_KEY=your-haystack-api-key
HAYSTACK_WORKSPACE=workspace-name
HAYSTACK_PIPELINE=pipeline-name
HAYSTACK_WORKSPACE_ID=workspace-uuid
HAYSTACK_PIPELINE_ID=pipeline-uuid
HAYSTACK_INDEX=index-name
